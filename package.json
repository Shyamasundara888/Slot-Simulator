{
  "name": "slot-simulator",
  "version": "0.1.0",
  "description": "Motore per creare slot machine moddabili",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
